# Copy to deploy/secrets/desktop-signing.env (git-ignored) and fill in.
# These are the exact variables CI reads from GitHub Secrets; Tauri picks them
# up from the environment — nothing goes into tauri.conf.json.

# Updater manifest/package signature (all platforms). Required.
TAURI_SIGNING_PRIVATE_KEY_PATH=deploy/secrets/deeix-chat-updater.key
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# macOS: Developer ID signing + notarization. Required to ship on macOS.
#   Identity must match the keychain entry exactly, e.g.
#   "Developer ID Application: DEEIX Inc. (ABCDE12345)"
APPLE_SIGNING_IDENTITY=
#   Apple ID e-mail, an *app-specific* password (appleid.apple.com), 10-char Team ID
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=
# Only for CI (the runner has no keychain): base64 of the exported .p12 and its password.
# Locally, leave empty — codesign uses the certificate in your login keychain.
APPLE_CERTIFICATE=
APPLE_CERTIFICATE_PASSWORD=

# Windows (.pfx). Optional until you have a certificate.
WINDOWS_CERTIFICATE=
WINDOWS_CERTIFICATE_PASSWORD=
